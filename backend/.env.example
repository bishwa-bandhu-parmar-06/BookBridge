# Translation provider: gemini | mock   (mock needs no API key; returns "[EN] " + text)
TRANSLATOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: comma-separated models to try when GEMINI_MODEL is busy (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=
# minimal | low | medium | high | default  ("thinking" makes translation much slower)
GEMINI_THINKING_LEVEL=minimal
# Seconds before giving up on a hanging model and trying the next one
GEMINI_TIMEOUT_SECONDS=25
# Seconds MockTranslator waits per batch (to see progress bars while testing)
MOCK_DELAY_SECONDS=0
TRANSLATION_BATCH_CHARS=4000
# Batches translated at the same time (keep low on free API tiers)
TRANSLATION_CONCURRENCY=3
TRANSLATION_MAX_ATTEMPTS=3

# Sessions & limits
SESSION_TTL_MINUTES=120
CLEANUP_INTERVAL_MINUTES=10
MAX_UPLOAD_MB=50
MAX_PAGES=500
DEFAULT_PAGES_PER_CHUNK=10
SESSIONS_DIR=./tmp_sessions

# Abuse protection: max uploads per IP per hour (0 = off). Set TRUST_PROXY_HEADERS=true only behind your own proxy.
UPLOAD_RATE_LIMIT_PER_HOUR=10
TRUST_PROXY_HEADERS=false
# Proxies in front of the API that add to X-Forwarded-For (hosting platforms: 1)
TRUSTED_PROXY_HOPS=1

# CORS: the website address(es), comma-separated. Optional regex for e.g. Vercel preview links.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_REGEX=

# Windows only: folder with the Pango DLLs for WeasyPrint (MSYS2 default shown; usually auto-detected)
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
